# MCP Server 配置
MCP_HOST=127.0.0.1
MCP_PORT=24601

# 认证 token —— 客户端 header 要带 Authorization: Bearer <此值>
# 生成：python -c "import secrets; print(secrets.token_hex(16))"
MCP_AUTH_TOKEN=change-me-to-random-hex

# 安全开关
AUTO_APPROVE=false            # true = 跳过 HITL 确认（危险，仅供 CI）
ALLOW_DESTRUCTIVE=false       # true = 允许 delete / save 这类不可逆操作（仍会 HITL，除非 AUTO_APPROVE 也 true）
ALLOW_EXEC_PYTHON=false       # true = 启用 system.exec_python 逃生舱；需同时 AUTO_APPROVE=false

# 限制
TOOL_CALL_TIMEOUT_SEC=30
MAX_PENDING_QUEUE=50
MAX_ENTITIES_IN_SNAPSHOT=2000

# 日志
LOG_LEVEL=INFO
LOG_DIR=./logs
